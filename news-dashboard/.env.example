# ============================================================
#  LLM 공급자 선택: gemini (무료 티어) 또는 anthropic
# ============================================================
LLM_PROVIDER=gemini

# --- Gemini (무료) -------------------------------------------
# 키 발급: https://aistudio.google.com/apikey  (신용카드 불필요)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# --- Anthropic (유료, 크레딧 필요) ----------------------------
# 키 발급: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5

# --- 뉴스 수집 -----------------------------------------------
# 구글 뉴스 RSS를 쓰면 없어도 됩니다
NEWS_API_KEY=

# 연속 LLM 호출 사이 대기(초). 미설정 시 gemini=6.5, anthropic=0.3
# LLM_REQUEST_DELAY=6.5
